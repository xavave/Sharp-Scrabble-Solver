<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dawg</RootNamespace>
    <AssemblyName>Dawg</AssemblyName>
    <!-- On conserve le fichier AssemblyInfo.cs existant (pas de génération auto, sinon attributs en double) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Conserve le GUID attendu par le fichier solution -->
    <ProjectGuid>{95AF0C36-E8CB-422A-9060-ACA73CCD0C36}</ProjectGuid>
  </PropertyGroup>

  <!-- Ces fichiers existent sur disque mais n'étaient PAS compilés dans l'ancien projet.
       On les exclut pour conserver exactement le même périmètre de compilation. -->
  <ItemGroup>
    <Compile Remove="Noeud1Temps.cs" />
    <Compile Remove="Noeud2Etapes.cs" />
  </ItemGroup>

  <!-- On n'embarque QUE les DAWG compilés (dico_dawg*.txt + EN_Collins_dawg.txt).
       Les listes de mots BRUTES (ex. "French ODS 8dictionary.txt", "liste_alpha_ODS9.txt")
       sont des ENTRÉES du DawgBuilder : on ne les embarque pas (sinon ~9 Mo inutiles dans la DLL). -->
  <ItemGroup>
    <None Remove="Resources\*.txt" />
    <EmbeddedResource Include="Resources\dico_dawg*.txt" />
    <EmbeddedResource Include="Resources\EN_Collins_dawg.txt" />
  </ItemGroup>

</Project>
