<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Dawg.Resolver.Winform</RootNamespace>
    <AssemblyName>Dawg.Resolver.Winform</AssemblyName>
    <StartupObject>Dawg.Solver.Winform.Test.Program</StartupObject>
    <ApplicationIcon>Scrabble_letters.ico</ApplicationIcon>
    <!-- On conserve l'AssemblyInfo.cs existant -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Conserve le nommage classique des ressources de formulaires (resx dans des sous-dossiers) :
         indispensable pour que les Form.resx (Forms\*, View\*) soient trouvés à l'exécution. -->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ProjectGuid>{8DA2C29C-DD08-4CAF-92AF-84012420155A}</ProjectGuid>
  </PropertyGroup>

  <!-- Plateaux de jeu + dictionnaire ODS7 embarqués ; EN_Collins copié à côté de l'exe (chargé par fichier) -->
  <ItemGroup>
    <None Remove="Resources\*.txt" />
    <EmbeddedResource Include="Resources\*.txt" />
    <None Update="EN_Collins_dawg.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dawg\Dawg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Requis par Properties\Settings.Designer.cs (System.Configuration n'est plus dans le framework de base) -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
