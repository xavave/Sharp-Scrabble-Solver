<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Dawg.Resolver.Winform</RootNamespace>
    <AssemblyName>Dawg.Resolver.Winform</AssemblyName>
    <StartupObject>Dawg.Solver.Winform.Test.Program</StartupObject>
    <ApplicationIcon>Scrabble_letters.ico</ApplicationIcon>
    <!-- On conserve l'AssemblyInfo.cs existant -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Conserve le nommage classique des ressources de formulaires (resx dans des sous-dossiers) :
         indispensable pour que les Form.resx (Forms\*, View\*) soient trouvés à l'exécution. -->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ProjectGuid>{8DA2C29C-DD08-4CAF-92AF-84012420155A}</ProjectGuid>
  </PropertyGroup>

  <!-- Seuls les plateaux de jeu sont nécessaires ici (chargés depuis CET assembly).
       Tous les dictionnaires (ODS6/7/8/9 + EN_Collins) sont embarqués dans l'assembly Dawg
       et chargés via le fallback ressources : plus aucun fichier dico côté WinForm. -->
  <ItemGroup>
    <None Remove="Resources\*.txt" />
    <EmbeddedResource Include="Resources\initial_board*.txt" />
  </ItemGroup>

  <!-- Polices des lettres du plateau : polices LIBRES (SIL OFL 1.1 / Apache 2.0, licences dans
       Resources\Fonts\licenses), redistribuables et versionnées. Liste explicite : tout autre .ttf
       présent dans le dossier (ex. anciennes polices Rostex, non libres) n'est PAS embarqué. -->
  <ItemGroup>
    <None Remove="Resources\Fonts\**" />
    <EmbeddedResource Include="Resources\Fonts\TitanOne-Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\LilitaOne-Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\Bungee-Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\LuckiestGuy-Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\BowlbyOne-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dawg\Dawg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Requis par Properties\Settings.Designer.cs (System.Configuration n'est plus dans le framework de base) -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
